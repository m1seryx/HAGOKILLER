# Public URL of your own backend endpoint. Never put provider keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_ASSESSMENT_API_URL=http://192.168.1.10:8787/assessment-advice

# Optional direct Android APK link used by the responsive /download webpage.
# Defaults to the latest HAGOKILLER GitHub Release asset named HAGOKILLER.apk.
EXPO_PUBLIC_ANDROID_APK_URL=https://github.com/m1seryx/HAGOKILLER/releases/latest/download/HAGOKILLER.apk

# Server-only variables used by server/assessment-advice.mjs
AI_PROVIDER=llama_cpp
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_API_KEY=hagokiller-local-key
LLAMA_MODEL=local
PORT=8787

# To use OpenAI instead, set AI_PROVIDER=openai and configure these:
# OPENAI_API_KEY=replace-on-server-only
# OPENAI_MODEL=gpt-4o-mini
